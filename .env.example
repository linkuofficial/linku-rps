# Frontend (Vite)
# Accepts: ws://, wss://, http://, https://, or host only.
# Example production value:
# VITE_WS_URL=wss://your-backend-domain
VITE_WS_URL=ws://localhost:3001

# Frontend gesture policy:
# - minimal: keep only chat swipe toggle
# - off: disable all touch gestures
VITE_GESTURE_MODE=minimal

# Backend
PORT=3001
ALLOWED_ORIGINS=https://your-frontend-domain,http://localhost:5173,http://127.0.0.1:5173
