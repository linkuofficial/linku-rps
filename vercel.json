{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack enable && pnpm install",
  "buildCommand": "pnpm --filter @rps/client build",
  "outputDirectory": "packages/client/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/join/:code",
      "destination": "/index.html"
    }
  ]
}