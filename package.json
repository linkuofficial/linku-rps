{
  "name": "rps-monorepo",
  "version": "2.0.0",
  "description": "Online rock-paper-scissors with rooms",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev:server": "pnpm --filter @rps/server dev",
    "dev:client": "pnpm --filter @rps/client dev",
    "build": "pnpm --filter @rps/server build && pnpm --filter @rps/client build",
    "start": "pnpm --filter @rps/server start",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write \"**/*.{json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{json,md,yml,yaml}\"",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "smoke:server": "pnpm --filter @rps/server build && node scripts/smoke-server.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=24"
  }
}
